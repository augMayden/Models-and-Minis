@startuml
skinparam monochrome true
skinparam actorStyle hollow
left to right direction

actor Buyer

rectangle "Webstore System" {
  usecase "Search for Product" as UC1
  usecase "Display Relevant Listings" as UC2
  usecase "Select Multiple Listings to Compare\n(compareListings)" as UC3
  usecase "Display Comparison View" as UC4
  usecase "Compare Listing Attributes\n(Price, Description, Seller)" as UC5
  usecase "Select Listing for Purchase" as UC6
  usecase "Validate Listing Availability\n(isAvailable)" as UC7
  usecase "Inform Unavailable & Remove\n(ALT1)" as UC8

  UC1 ..> UC2 : <<include>>
  UC2 ..> UC3 : <<include>>
  UC3 ..> UC4 : <<include>>
  UC4 ..> UC5 : <<include>>
  UC5 ..> UC6 : <<include>>
  UC6 ..> UC7 : <<include>>
  
  UC7 ..> UC8 : <<extend>>\n(ALT1: Listing unavailable/invalid)
}

Buyer --> UC1
Buyer --> UC3
Buyer --> UC5
Buyer --> UC6

@enduml