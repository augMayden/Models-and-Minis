@startuml
autonumber
skinparam Monochrome true
skinparam ParticipantBackgroundColor #F9F9F9

actor Buyer
participant "System" as System
participant "Database" as DB

== Navigation & Item Selection ==
Buyer -> System: login(credentials)
activate System

System -> DB: verifyCredentials()
activate DB
DB --> System: authentication success
deactivate DB

System --> Buyer: returns Boolean (true)
deactivate System

Buyer -> System: viewOrderHistory()
activate System

System -> DB: queryOrderHistory()
activate DB
DB --> System: returns List<Order>
deactivate DB

System --> Buyer: displays order history
deactivate System

Buyer -> System: selects order & chooses specific OrderItem
activate System

System -> DB: getItems() [from Order]
activate DB
DB --> System: returns List<OrderItem>
deactivate DB

System --> Buyer: displays item details
deactivate System

Buyer -> System: requestRefund(reason) [on OrderItem]

== Eligibility Validation & Submission (ALT2) ==
System -> DB: checkItemEligibility()
activate System
activate DB
DB --> System: returns eligibility status
deactivate DB

alt ALT2: Item is not eligible
    System --> Buyer: informs item is ineligible & prevents submission
    deactivate System
else Item is eligible
    System -> DB: create RefundRequest record
    activate DB
    DB --> System: RefundRequest saved (Status: Pending)
    deactivate DB
    
    System --> Buyer: returns RefundRequest object & confirms submission
    deactivate System

    == Review & Decision Process (ALT1) ==
    note over System, DB: Seller / Admin reviews request asynchronously
    
    DB -> System: approve() / deny(reason) [on RefundRequest]
    activate System
    
    alt ALT1: Refund request is denied (deny(reason))
        System --> Buyer: informs request denied with decisionReason
    else Refund approved (approve())
        System --> Buyer: informs request approved
    end
    deactivate System
end

@enduml