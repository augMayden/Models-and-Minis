@startuml
autonumber
skinparam Monochrome true
skinparam ParticipantBackgroundColor #F9F9F9

actor Buyer
participant "System" as System
participant "Database" as DB

== Authentication & Dashboard ==
Buyer -> System: login(credentials)
activate System

System -> DB: verifyCredentials()
activate DB
DB --> System: authentication success
deactivate DB

System --> Buyer: returns Boolean (true)
deactivate System

== Navigate to Order History ==
Buyer -> System: viewOrderHistory()
activate System

System -> DB: queryOrderHistory(buyerID)
activate DB
DB --> System: returns List<Order>
deactivate DB

== Check Order History Existence (ALT1) ==
alt ALT1: Buyer has no previous orders
    System --> Buyer: informs no previous orders are available
else Buyer has 1+ orders
    System --> Buyer: displays list of previous orders
    deactivate System

    == View Specific Order Details ==
    Buyer -> System: selects specific Order
    activate System

    System -> DB: getItems() [from Order]
    activate DB
    DB --> System: returns List<OrderItem> & Listing details
    deactivate DB

    System --> Buyer: displays order details (items, seller, price, status)
    deactivate System
end

@enduml