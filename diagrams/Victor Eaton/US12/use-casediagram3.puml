@startuml
skinparam monochrome true
skinparam actorStyle hollow
left to right direction

actor Buyer

rectangle "Webstore System" {
  usecase "Login to Account\n(login)" as UC1
  usecase "Navigate to Account Page" as UC2
  usecase "Select Order History Option\n(viewOrderHistory)" as UC3
  usecase "Check Previous Orders" as UC4
  usecase "Display Previous Orders" as UC5
  usecase "Inform No Orders Available\n(ALT1)" as UC6
  usecase "Select Individual Order" as UC7
  usecase "Display Order Details\n(Items, Seller, Price, Status)" as UC8

  UC1 ..> UC2 : <<include>>
  UC2 ..> UC3 : <<include>>
  UC3 ..> UC4 : <<include>>
  
  UC4 ..> UC5 : <<extend>>\n(Buyer has 1+ orders)
  UC4 ..> UC6 : <<extend>>\n(ALT1: Buyer has 0 orders)
  
  UC5 ..> UC7 : <<include>>
  UC7 ..> UC8 : <<include>>
}

Buyer --> UC1
Buyer --> UC2
Buyer --> UC3
Buyer --> UC7

@enduml